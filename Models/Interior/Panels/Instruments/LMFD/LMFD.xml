<?xml version="1.0"?>
<PropertyList>

	<path>LMFD.ac</path>

	<animation>
        <type>material</type>
        <object-name>LCD</object-name>
        <emission>
            <red>1</red>
            <green>1</green>
            <blue>1</blue>
        </emission> 
    </animation> 
  
  
	<model>
		<path>Aircraft/UH-60/Models/Interior/Panels/Instruments/FGUKMap/GPS.xml</path>
		<offsets>
			<x-m>-0.0075</x-m>
			<y-m>0</y-m>
			<z-m>0.006</z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
		<overlay>
		 <animation n="101">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.84</y-offset>
    <z-offset>1.3</z-offset>
   </animation>
  </overlay>
	</model>
	

	<animation>
        <type>select</type>
<object-name>FGBR_GPS_COVER</object-name>
<object-name>Button_On</object-name>
<object-name>Button_Off</object-name>
<object-name>FGBR_GPS_NAMEPLATE</object-name>



<condition>
<not><or>
				<equals>
				  <property>sim/current-view/internal</property>
				  <value>true</value>
				  </equals>

				  <equals>
				  <property>sim/current-view/internal</property>
				  <value>false</value>
				  </equals>

				 </or>  </not>
			</condition>

    </animation>

	

</PropertyList>