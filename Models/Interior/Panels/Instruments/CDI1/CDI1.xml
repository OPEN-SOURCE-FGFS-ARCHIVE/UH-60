<?xml version="1.0"?>

<PropertyList>

    <path>CDI1.ac</path>

<!-- LIGHTING -->

  <animation>
        <object-name>base</object-name>
        <object-name>key</object-name>
     <type>material</type>
     <emission> 
     <factor-prop>controls/lighting/instrument-lights-norm</factor-prop>
        <red>  0.0 </red>
        <green>0.4</green>
        <blue> 0.8</blue>
      </emission>
  </animation> 

  <animation>
        <object-name>green</object-name>
        <object-name>display</object-name>
     <type>material</type>
     <emission> 
        <red>  1 </red>
        <green>1</green>
        <blue> 1</blue>
      </emission>
  </animation> 

