	<!-- active warnings -->
	
	<animation>
        <type>select</type>
        <object-name>FUEL1</object-name>
        
        <condition>
		<or>
			<less-than>
				<property>consumables/fuel/tank/level-gal_us/</property>
						<value>50</value>
					</less-than>
							
			 <equals>
      <property>controls/electric/warningtest</property>
	   <value>true</value>
	   </equals>
</or>	   
			</condition>
    </animation>
	
	<animation>
        <type>select</type>
        <object-name>FUEL2</object-name>
        
        <condition>
		<or>
			<less-than>
				<property>consumables/fuel/tank[1]/level-gal_us/</property>
						<value>50</value>
					</less-than>
							
			 <equals>
      <property>controls/electric/warningtest</property>
	   <value>true</value>
	   </equals>
</or>	   
			</condition>
    </animation>
	
	
	<animation>
        <type>select</type>
        <object-name>gen1</object-name>
        
        <condition>
		<or>
			<equals>
				<property>controls/electric/engine/generator</property>
						<value>false</value>
					</equals>
							
			 <equals>
      <property>controls/electric/warningtest</property>
	   <value>true</value>
	   </equals>
</or>	   
			</condition>
    </animation>
	
	<animation>
        <type>select</type>
        <object-name>gen2</object-name>
        
        <condition>
		<or>
			<equals>
				<property>controls/electric/engine[1]/generator</property>
						<value>false</value>
					</equals>
							
			 <equals>
      <property>controls/electric/warningtest</property>
	   <value>true</value>
	   </equals>
</or>	   
			</condition>
    </animation>
  
  
  <animation>
        <type>select</type>
        <object-name>1engoilpress</object-name>
        
        <condition>
		<or>
			<less-than>
				<property>engines/engine/oil-pressure-bar</property>
						<value>3.5</value>
					</less-than>
					
					<greater-than>
				<property>engines/engine/oil-pressure-bar</property>
						<value>5</value>
					</greater-than>
							
			 <equals>
      <property>controls/electric/warningtest</property>
	   <value>true</value>
	   </equals>
</or>	   
			</condition>
    </animation>
	
	 <animation>
        <type>select</type>
        <object-name>2engoilpress</object-name>
        
        <condition>
		<or>
			<less-than>
				<property>engines/engine[1]/oil-pressure-bar</property>
						<value>3.5</value>
					</less-than>
					
					<greater-than>
