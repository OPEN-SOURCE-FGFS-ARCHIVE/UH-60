<animation>
        <type>select</type>
        <object-name>hookarmed</object-name>
        
        <condition>
		<or>
			<equals>
				<property>sim/cargo/cargo-auto-hook</property>
						<value>true</value>
					</equals>	
					
							
			 <equals>
      <property>controls/electric/warningtest</property>
	   <value>true</value>
	   </equals>
</or>	   
			</condition>
