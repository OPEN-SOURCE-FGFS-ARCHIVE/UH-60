	<animation>
        <type>select</type>
        <object-name>sasoff</object-name>
        
        <condition>
		<or>
			<less-than>
				<property>controls/flight/fcs/sas-enabled</property>
						<value>1</value>
					</less-than>
					
							
			 <equals>
      <property>controls/electric/warningtest</property>
	   <value>true</value>
	   </equals>
</or>	   
			</condition>
    </animation>
	
	<animation>
        <type>select</type>
        <object-name>lftpitot</object-name>
		 <object-name>rtpitot</object-name>
        
        <condition>
		<or>
		<and>
			<equals>
				<property>controls/anti-ice/pitot-heat</property>
						<value>false</value>
					</equals>
					
