				<property>environment/temperature-degc</property>
						<value>5</value>
					</less-than>	
			</and>				
			 <equals>
      <property>controls/electric/warningtest</property>
	   <value>true</value>
	   </equals>
</or>	   
			</condition>
    </animation>
	
	<animation>
